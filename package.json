{
  "name": "aero-ui",
  "version": "0.1.0",
  "description": "AI 友好的企业级 Vue 3 组件库",
  "type": "module",
  "packageManager": "pnpm@10.34.4",
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/lib/index.cjs",
  "module": "./dist/es/index.mjs",
  "types": "./dist/types/index.d.ts",
  "sideEffects": [
    "**/*.css",
    "**/*.scss"
  ],
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/es/index.mjs",
      "require": "./dist/lib/index.cjs"
    },
    "./components/*": {
      "types": "./dist/types/components/*/index.d.ts",
      "import": "./dist/es/components/*/index.mjs",
      "require": "./dist/lib/components/*/index.cjs"
    },
    "./components/*/style/*": {
      "import": "./dist/es/components/*/style/*.css",
      "require": "./dist/lib/components/*/style/*.css"
    },
    "./resolver": {
      "types": "./dist/types/resolver/index.d.ts",
      "import": "./dist/es/resolver/index.mjs",
      "require": "./dist/lib/resolver/index.cjs"
    },
    "./locale": {
      "types": "./dist/types/locale/index.d.ts",
      "import": "./dist/es/locale/index.mjs",
      "require": "./dist/lib/locale/index.cjs"
    },
    "./locale/lang/*": {
      "types": "./dist/types/locale/lang/*.d.ts",
      "import": "./dist/es/locale/lang/*.mjs",
      "require": "./dist/lib/locale/lang/*.cjs"
    },
    "./hooks": {
      "types": "./dist/types/hooks/index.d.ts",
      "import": "./dist/es/hooks/index.mjs",
      "require": "./dist/lib/hooks/index.cjs"
    },
    "./theme/*": "./dist/theme/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vite build && node scripts/build-styles.mjs",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --ext .vue,.ts,.tsx",
    "lint:fix": "eslint . --ext .vue,.ts,.tsx --fix",
    "format": "prettier --write \"packages/**/*.{ts,vue,scss}\""
  },
  "peerDependencies": {
    "vue": "^3.4.0"
  },
  "dependencies": {
    "@vueuse/core": "^10.9.0",
    "vue-i18n": "^9.10.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vitejs/plugin-vue": "^5.0.0",
    "@vue/test-utils": "^2.4.0",
    "eslint": "^8.57.0",
    "eslint-plugin-vue": "^9.20.0",
    "jsdom": "^24.0.0",
    "prettier": "^3.2.0",
    "sass": "^1.70.0",
    "typescript": "~5.4.5",
    "unplugin-vue-components": "^0.26.0",
    "vite": "^5.0.0",
    "vite-plugin-dts": "^3.7.0",
    "vitepress": "1.6.3",
    "vitest": "^1.3.0",
    "vue": "^3.4.0",
    "vue-tsc": "^1.8.0"
  }
}
